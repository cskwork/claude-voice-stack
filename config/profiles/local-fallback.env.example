# claude-voice-stack — local fallback profile (optional, not the default)
# Same local ears and voice, but the foreground router runs locally through
# MLX instead of the remote GLM API. Costs several GB of unified memory; use
# it only when the GLM endpoint is unavailable and offline routing matters.

QWEN_AUDIO_REALTIME_PROVIDER=speech-to-speech
SPEECH_TO_SPEECH_REALTIME_URL=ws://127.0.0.1:8765/v1/realtime
QWEN_AUDIO_AGENT_FRONTEND_PROMPT_DIR=config/prompts/foreground-glm
QWEN_AUDIO_AGENT_ASSISTANT_PROFILE_PATH=config/prompts/foreground-glm/ASSISTANT.md
QWEN_AUDIO_SCHEDULE_TOOL_ENABLED=false
QWEN_AUDIO_WEB_TOOLS_ENABLED=false
QWEN_AUDIO_KNOWLEDGE_TOOL_ENABLED=false
QWEN_AUDIO_NOTES_TOOL_ENABLED=false
QWEN_AUDIO_RECALL_TOOL_ENABLED=false

AGENT_PROTOCOL=claude
QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
QWEN_AUDIO_AGENT_BACKEND_MODEL=
CLAUDE_WORKSPACE=

# Local MLX router. Requires: ~/.claude-voice-stack/venv-s2s with the
# speech-to-speech[mlx-lm] extra installed.
VOICE_LLM_BACKEND=mlx-lm
VOICE_LLM_MODEL=mlx-community/Qwen3-1.7B-4bit
VOICE_LLM_CHAT_SIZE=4

VOICE_STT=whisper-mlx
VOICE_STT_MODEL=small
VOICE_STT_LANGUAGE=

VOICE_TTS_MODE=supertonic
SUPERTONIC_VOICE=M1
SUPERTONIC_LANGUAGE=na
SUPERTONIC_SPEED=1.0

VOICE_S2S_HOST=127.0.0.1
VOICE_S2S_PORT=8765
VOICE_PIPELINES=1
VOICE_LIVE_TRANSCRIPTION=true
VOICE_LOG_TRANSCRIPTS=false

HOST=127.0.0.1
PORT=3101
