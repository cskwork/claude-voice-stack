# claude-voice-stack — default profile
# Local ears and voice (Parakeet TDT + Supertonic), remote GLM-5.3-Flash as the
# foreground router, Claude Code as the only backend agent.
#
# Copy to ~/.claude-voice-stack/config.env (voice-agent setup does this) and
# fill in VOICE_LLM_BASE_URL / VOICE_LLM_API_KEY. Never commit the filled file.

# --------------------------------------------------
# Voice provider (upstream qwen-audio-agent settings)
# --------------------------------------------------
QWEN_AUDIO_REALTIME_PROVIDER=speech-to-speech
SPEECH_TO_SPEECH_REALTIME_URL=ws://127.0.0.1:8765/v1/realtime

# Compact English foreground prompt for GLM (relative to the repository root).
QWEN_AUDIO_AGENT_FRONTEND_PROMPT_DIR=config/prompts/foreground-glm
QWEN_AUDIO_AGENT_ASSISTANT_PROFILE_PATH=config/prompts/foreground-glm/ASSISTANT.md

# Optional frontend tools the router does not need. Off keeps the tool list
# and the GLM context small.
QWEN_AUDIO_SCHEDULE_TOOL_ENABLED=false
QWEN_AUDIO_WEB_TOOLS_ENABLED=false
QWEN_AUDIO_KNOWLEDGE_TOOL_ENABLED=false
QWEN_AUDIO_NOTES_TOOL_ENABLED=false
QWEN_AUDIO_RECALL_TOOL_ENABLED=false

# --------------------------------------------------
# Backend Agent (Claude Code via claude-code-acp)
# --------------------------------------------------
AGENT_PROTOCOL=claude
QWEN_AUDIO_AGENT_BACKEND_PERMISSION_MODE=native
# Empty = Claude Code uses its own configured model.
QWEN_AUDIO_AGENT_BACKEND_MODEL=
# Repository Claude Code works in. Empty = upstream shared workspace.
CLAUDE_WORKSPACE=
# CLAUDE_CODE_EXECUTABLE=
# CLAUDE_CODE_ACP_BIN=

# --------------------------------------------------
# GLM foreground LLM (OpenAI-compatible Chat Completions)
# --------------------------------------------------
VOICE_LLM_BACKEND=chat-completions
VOICE_LLM_MODEL=glm-5.3-flash
# Z.ai general API: https://api.z.ai/api/paas/v4
# Z.ai coding plan:  https://api.z.ai/api/coding/paas/v4
# Zhipu (CN):        https://open.bigmodel.cn/api/paas/v4
VOICE_LLM_BASE_URL=
VOICE_LLM_API_KEY=
VOICE_LLM_STREAM=true
# Recent turns kept verbatim in the voice context; older turns are compacted.
VOICE_LLM_CHAT_SIZE=4
# Provider-specific reasoning knob (for example "none" or "low"). Leave empty
# until `voice-agent smoke-glm` confirms the endpoint accepts it.
VOICE_LLM_REASONING_EFFORT=

# --------------------------------------------------
# STT (local, MLX)
# --------------------------------------------------
# mlx-audio-whisper = whisper-large-v3-turbo; Korean and English verified in
#                     the integration test. Default.
# parakeet-tdt      = smaller and faster, English/European languages only.
#                     Measured: Korean speech comes out as garbage, so use it
#                     only for English-only sessions.
VOICE_STT=mlx-audio-whisper
# Empty = per-utterance auto detection. Set "ko" or "en" to pin the language.
VOICE_STT_LANGUAGE=

# --------------------------------------------------
# TTS (local Supertonic)
# --------------------------------------------------
# supertonic     = Supertonic runs inside the speech-to-speech process (one
#                  model load, no HTTP hop). Default.
# openai-http    = speech-to-speech calls a separate `supertonic serve` at
#                  SUPERTONIC_BASE_URL via /v1/audio/speech.
VOICE_TTS_MODE=supertonic
# Voice style M1-M5 or F1-F5.
SUPERTONIC_VOICE=M1
# "na" = language-agnostic auto. "ko" / "en" pin the language.
SUPERTONIC_LANGUAGE=na
SUPERTONIC_SPEED=1.0
# Only used when VOICE_TTS_MODE=openai-http
SUPERTONIC_BASE_URL=http://127.0.0.1:7788/v1
SUPERTONIC_MODEL=supertonic-3

# --------------------------------------------------
# Realtime server (speech-to-speech)
# --------------------------------------------------
VOICE_S2S_HOST=127.0.0.1
VOICE_S2S_PORT=8765
VOICE_PIPELINES=1
VOICE_LIVE_TRANSCRIPTION=true
# Do not log transcripts in normal use. `voice-agent start --debug-transcripts`
# overrides this for one run.
VOICE_LOG_TRANSCRIPTS=false

# --------------------------------------------------
# Gateway
# --------------------------------------------------
HOST=127.0.0.1
PORT=3101
